# Copy to .env (never commit .env). All values are optional for a local demo.

# Claude API key: enables AI triage (category suggestion). Without it the offline keyword classifier is used.
ANTHROPIC_API_KEY=

# Google Gemini API key (free tier, https://aistudio.google.com/apikey): enables free AI triage.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.8-flash

# Telegram bot token from @BotFather: enables the Telegram channel and chat reporting.
TELEGRAM_BOT_TOKEN=

# Signing key for login tokens (at least 32 characters). Set it for any shared deployment.
# JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
