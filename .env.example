# Copy to .env (never commit .env). All values are optional for a local demo.


# Google Gemini API key (https://aistudio.google.com/apikey): enables AI triage on submission.
GEMINI_API_KEY=
# Optional: override the Gemini model (default gemini-3.5-flash-lite).
# GEMINI_MODEL=gemini-3.8-flash


# Signing key for login tokens (at least 32 characters). Set it for any shared deployment.
# JWT_SECRET=replace-with-a-long-random-string-of-32-or-more-characters
